<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ 的数据提取规则（dataExtractionRules）。

  重要：笔记数据存放在 Room 数据库（database 域的 notes_database.db）中，
  必须包含 database 域，否则换机 / 重装后用户笔记会全部丢失。
  这里同时排除 Room 的 WAL / SHM 临时文件，避免恢复出不一致的数据库快照。

  注意：device-transfer 段落用于"换机直传"，与 cloud-backup 保持一致的包含范围，
  确保无论走云备份还是设备直传，笔记都完整保留。
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- 笔记正文：Room 数据库 -->
        <include domain="database" path="notes_database.db"/>
        <!-- 主题 / 背景等设置：DataStore Preferences -->
        <include domain="sharedpref" path="."/>
        <include domain="file" path="datastore/"/>
        <!-- 笔记内图片：不包含则换机后图文笔记只剩文字、图片全部裂掉 -->
        <include domain="file" path="note_images/"/>

        <exclude domain="sharedpref" path="device.xml"/>
        <exclude domain="database" path="notes_database.db-wal"/>
        <exclude domain="database" path="notes_database.db-shm"/>
        <exclude domain="database" path="notes_database.db-journal"/>
    </cloud-backup>

    <device-transfer>
        <include domain="database" path="notes_database.db"/>
        <include domain="sharedpref" path="."/>
        <include domain="file" path="datastore/"/>
        <!-- 换机直传同样要带上图片 -->
        <include domain="file" path="note_images/"/>

        <exclude domain="sharedpref" path="device.xml"/>
        <exclude domain="database" path="notes_database.db-wal"/>
        <exclude domain="database" path="notes_database.db-shm"/>
        <exclude domain="database" path="notes_database.db-journal"/>
    </device-transfer>
</data-extraction-rules>
