<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- 应用主背景色（浅色），用于启动窗口背景，消除白屏 -->
    <style name="Theme.NotesApp" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- 启动主题：使用 SplashScreen 主题，并将窗口背景设为应用背景色，
         避免冷启动时出现白屏闪烁 -->
    <style name="Theme.NotesApp.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/launch_background_light</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.NotesApp</item>
    </style>

</resources>
